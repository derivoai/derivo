{
  "name": "derivo-workspace",
  "private": true,
  "scripts": {
    "dev": "npx pnpm --filter react-example dev",
    "build": "npx pnpm --filter react-example build",
    "lint": "npx pnpm --filter react-example lint",
    "typecheck": "npx pnpm --filter react-example typecheck",
    "test": "npx pnpm --filter react-example test",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,js}\"",
    "clean": "npx pnpm --filter react-example clean",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "eslint": "^9.5.0",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.7",
    "prettier": "^3.3.2",
    "turbo": "^2.0.4",
    "typescript": "^5.4.5"
  },
  "packageManager": "pnpm@9.4.0"
}
